{
  "openapi": "3.0.0",
  "info": {
    "title": "UniShop API Documentation",
    "description": "UniShop API Documentation",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://shoptest1.surgelab.io",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/v1/order/search-by-sn": {
      "post": {
        "tags": ["Orders"],
        "summary": "Search order by order number",
        "description": "Search for a single order by its order number",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_sn"],
                "properties": {
                  "order_sn": {
                    "type": "string",
                    "description": "Order number",
                    "example": "ABC123DEF456GHI7"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Bad request"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/order/search-by-email": {
      "post": {
        "tags": ["Orders"],
        "summary": "Search orders by email",
        "description": "Search for orders by email address",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address",
                    "example": "user@example.com"
                  },
                  "search_pwd": {
                    "type": "string",
                    "description": "Search password (optional)",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/order/search-by-browser": {
      "post": {
        "tags": ["Orders"],
        "summary": "Search orders by browser cache",
        "description": "Search for orders stored in browser cookies",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Error code",
            "example": 400
          },
          "message": {
            "type": "string",
            "description": "Error message",
            "example": "Bad request"
          },
          "data": {
            "type": "null",
            "description": "Error data is null",
            "example": null
          }
        }
      }
    }
  }
}